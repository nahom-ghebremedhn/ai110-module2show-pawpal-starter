classDiagram
    %% Keep this file updated so it matches your final implementation.

    class Priority {
        <<enumeration>>
        LOW = 1
        MEDIUM = 2
        HIGH = 3
    }

    class Owner {
        +str name
        +dict preferences
        +int available_time
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +set_preferences(preferences: dict) None
        +set_available_time(minutes: int) None
        +get_all_tasks() list~tuple~
    }

    class Pet {
        +str name
        +str species
        +list~CareTask~ tasks
        +update_info(name: str, species: str) None
        +add_task(task: CareTask) None
        +remove_task(title: str) None
        +get_pet_info() str
    }

    class CareTask {
        +str title
        +int duration_minutes
        +Priority priority
        +update_task(title: str, duration_minutes: int, priority: Priority) None
        +calculate_priority() int
    }

    class ScheduledTask {
        +Pet pet
        +CareTask task
        +time start_time
    }

    class SkippedTask {
        +Pet pet
        +CareTask task
        +str reason
    }

    class Scheduler {
        +Owner owner
        +time day_start
        +list~ScheduledTask~ daily_schedule
        +list~SkippedTask~ skipped_tasks
        +prioritize_tasks() list~tuple~
        +generate_schedule() list~ScheduledTask~
        +explain_schedule() str
    }

    Owner "1" o-- "*" Pet : has
    Pet "1" o-- "*" CareTask : needs
    CareTask --> Priority : uses
    Scheduler --> Owner : reads time, prefs, pets
    Scheduler "1" *-- "*" ScheduledTask : produces
    Scheduler "1" *-- "*" SkippedTask : records
    ScheduledTask --> Pet
    ScheduledTask --> CareTask
    SkippedTask --> Pet
    SkippedTask --> CareTask
